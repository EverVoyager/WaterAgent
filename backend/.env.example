# ========== 应用配置 ==========
APP_NAME=water-agents
APP_VERSION=0.1.0
# development / production（production 启动时会校验 API Key 不能为占位符）
APP_ENV=development

# 后端服务
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS 允许的前端来源（多个用逗号分隔）
# production 模式建议收紧为具体域名，如 https://water.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting（slowapi）
# 每分钟每个 IP 的最大请求数
RATE_LIMIT_PER_MINUTE=30

# ========== LLM 配置（OpenAI 兼容接口）==========
# 阿里云通义：https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek：https://api.deepseek.com/v1
# 智谱 GLM：https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
# 单次会话最大工具调用轮次（防止死循环）
LLM_MAX_TOOL_ROUNDS=5
# 评判模型（双模型蒸馏的评判角色，用更强模型做语义质量打分）
# 留空则回退到 LLM_MODEL；建议配置为 qwen-max 等更强模型
LLM_JUDGE_MODEL=
# Embedding 模型（用于法规 RAG 检索 + Skill 匹配）
LLM_EMBEDDING_MODEL=
# Embedding 独立 API（与推理 LLM_API_KEY 分开授权/计费；两者留空则回退用 LLM_API_KEY/LLM_BASE_URL）
# 典型场景：推理切 DeepSeek（无 embedding API）时，embedding 留在 DashScope：
#   EMBEDDING_API_KEY=sk-your-dashscope-key
#   EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ========== Qdrant 向量库配置（用于法规 RAG 检索）==========
# 下载 qdrant.exe: https://github.com/qdrant/qdrant/releases
# 双击 qdrant.exe 后默认监听 6333 端口
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=water_regulations
# 向量维度（需与 DashScope text-embedding-v3 一致）
QDRANT_VECTOR_SIZE=1024

# ========== 高德天气 API（阶段 F 接入实时天气）==========
# 申请：https://lbs.amap.com/dev/key/app（选 Web服务 API 类型）
# 留空则降级到 mock
AMAP_API_KEY=
# 吕梁市 adcode（高德城市编码）
AMAP_CITY_CODE=141100

# ========== Tavily 联网搜索 API（web_search 工具）==========
# 申请：https://tavily.com（免费额度 1000 次/月）
# 留空则降级到 mock
TAVILY_API_KEY=

# ========== 水文数据源配置（阶段 F 接入实时水情）==========
# 数据源：qqjjsj.com 每日发布黄河水文站水位流量（来源于水利部公开数据）
HYDRO_SOURCE_URL=http://www.qqjjsj.com/list226a1/
# 缓存 TTL（秒）：避免高频请求被封，默认 30 分钟
HYDRO_CACHE_TTL=1800

# ========== 上下文 token 压缩 ==========
# history 总 token 超过此值时触发任务段折叠压缩（借鉴 Codex compact + Context-Folding）
HISTORY_MAX_TOKENS=4000
# 压缩时保留最近几轮原文（1 轮 = 1 问 1 答 = 2 条消息）
HISTORY_KEEP_RECENT_ROUNDS=2

# ========== 会话任务段落盘与按需还原 ==========
# 超预算时早段折叠为冻结的结构化摘要（全文含工具数据落 session_archive/*.md），
# 当前 query 与早段匹配时按需还原整段注入（详见 docs/context-compression-research.md）
SESSION_ARCHIVE_ENABLED=true
# 分段语义边界：相邻轮 query embedding 余弦低于此值开新段
SESSION_SEGMENT_SIM_THRESHOLD=0.5
# 按需还原：匹配余弦阈值 / 最多还原段数 / 归档保留天数
SESSION_ARCHIVE_MATCH_THRESHOLD=0.5
SESSION_ARCHIVE_TOP_K=2
SESSION_ARCHIVE_MAX_AGE_DAYS=30

# ========== MySQL 配置（自进化长期记忆 + 会话持久化存储）==========
# 用于 Hermes 范式自进化：跨会话记忆 + 技能积累
# 留空 MYSQL_PASSWORD 则禁用自进化记忆持久化（反思循环仍可运行但不持久化）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=water_agent
# 长期记忆双层文件（对标 Claude Code：MEMORY.md 用户手册 Agent 只读 + memory/ 目录自动记忆）
AUTO_MEMORY_ENABLED=true
MEMORY_FILE=MEMORY.md
MEMORY_DIR=memory
# 自进化总开关（false 时反思循环不运行，Agent 退化为无记忆模式）
SELF_EVOLUTION_ENABLED=true

# ========== Curator 定期记忆治理（借鉴 Hermes Curator）==========
# 后台线程定期执行：剪枝僵尸记忆 / LLM 压缩合并 / 向量索引对账
CURATOR_ENABLED=true
# 治理周期（小时），默认 168 = 每周一次
CURATOR_INTERVAL_HOURS=168
