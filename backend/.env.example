# ========== 应用配置 ==========
APP_NAME=yellow-river-agent
APP_VERSION=0.1.0
# development / production（production 启动时会校验 API Key 不能为占位符）
APP_ENV=development

# 后端服务
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS 允许的前端来源（多个用逗号分隔）
# production 模式建议收紧为具体域名，如 https://water.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting（slowapi）
# 每分钟每个 IP 的最大请求数
RATE_LIMIT_PER_MINUTE=30

# ========== LLM 配置（OpenAI 兼容接口）==========
# 阿里云通义：https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek：https://api.deepseek.com/v1
# 智谱 GLM：https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
# 单次会话最大工具调用轮次（防止死循环）
LLM_MAX_TOOL_ROUNDS=5
# Embedding 模型（用于意图路由 Semantic Router）
LLM_EMBEDDING_MODEL=text-embedding-v3

# Semantic Router 阈值（低于此余弦相似度时退化为规则化兜底）
SEMANTIC_ROUTER_THRESHOLD=0.55

# ========== Qdrant 向量库配置（用于法规 RAG 检索）==========
# 下载 qdrant.exe: https://github.com/qdrant/qdrant/releases
# 双击 qdrant.exe 后默认监听 6333 端口
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=water_regulations
# 向量维度（需与 DashScope text-embedding-v3 一致）
QDRANT_VECTOR_SIZE=1024

# ========== 高德天气 API（阶段 F 接入实时天气）==========
# 申请：https://lbs.amap.com/dev/key/app（选 Web服务 API 类型）
# 留空则降级到 mock
AMAP_API_KEY=
# 吕梁市 adcode（高德城市编码）
AMAP_CITY_CODE=141100

# ========== 水文数据源配置（阶段 F 接入实时水情）==========
# 数据源：qqjjsj.com 每日发布黄河水文站水位流量（来源于水利部公开数据）
HYDRO_SOURCE_URL=http://www.qqjjsj.com/list226a1/
# 缓存 TTL（秒）：避免高频请求被封，默认 30 分钟
HYDRO_CACHE_TTL=1800

# ========== LangFuse LLM 追踪（可选）==========
# 留空则不启用 LangFuse 追踪，仅用 structlog 本地日志
# 申请：https://cloud.langfuse.com/（云服务）或自托管 docker
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ========== MySQL 配置（自进化长期记忆存储）==========
# 用于 Hermes 范式自进化：跨会话记忆 + 技能积累
# 留空 MYSQL_PASSWORD 则禁用自进化记忆持久化（反思循环仍可运行但不持久化）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=water_agent
# 自进化总开关（false 时反思循环不运行，Agent 退化为无记忆模式）
SELF_EVOLUTION_ENABLED=true
