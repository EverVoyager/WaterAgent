# ========== Docker Compose 环境变量示例 ==========
# 此文件同时供 backend 服务的 env_file 加载，字段需与 backend/.env.example 对齐。
# 使用时复制为 .env 并填入真实值。
#
# docker compose up               仅 qdrant + backend + frontend（云 LLM）
# docker compose --profile local-llm up   额外启动 vllm（本地微调模型，需 GPU）
# docker compose --profile train up       额外启动训练任务

# ===== Docker Compose 专属变量 =====
# 本地微调模型目录（挂载到 vllm 容器的 /models，仅 --profile local-llm 时使用）
MODEL_DIR=../train/grpo/outputs

# ========== 应用配置 ==========
APP_NAME=water-agents
APP_VERSION=0.1.0
# development / production（production 启动时会校验 API Key 不能为占位符）
APP_ENV=production

# 后端服务
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS 允许的前端来源（多个用逗号分隔）
CORS_ORIGINS=http://localhost:8080

# Rate Limiting（slowapi）
RATE_LIMIT_PER_MINUTE=30

# ========== LLM 配置（OpenAI 兼容接口）==========
# 默认 DashScope 云链路
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
# 单次会话最大工具调用轮次（防止死循环）
LLM_MAX_TOOL_ROUNDS=5
# 评判模型（双模型蒸馏的评判角色，建议配置为 qwen-max 等更强模型）
LLM_JUDGE_MODEL=
# Embedding 模型（用于法规 RAG 检索 + Skill 匹配）
LLM_EMBEDDING_MODEL=

# 本地微调模型（--profile local-llm 时覆盖以下两项）
# LLM_BASE_URL=http://vllm:8000/v1
# LLM_MODEL=water-agent-fc

# ========== Qdrant 向量库配置（用于法规 RAG 检索）==========
# Docker 模式下用服务名 qdrant 替代 127.0.0.1
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=water_regulations
QDRANT_VECTOR_SIZE=1024

# ========== 高德天气 API ==========
# 申请：https://lbs.amap.com/dev/key/app（选 Web服务 API 类型）
# 留空则降级到 mock
AMAP_API_KEY=
# 吕梁市 adcode（高德城市编码）
AMAP_CITY_CODE=141100

# ========== Tavily 联网搜索 API（web_search 工具）==========
# 申请：https://tavily.com（免费额度 1000 次/月）
# 留空则降级到 mock
TAVILY_API_KEY=

# ========== 水文数据源配置 ==========
HYDRO_SOURCE_URL=http://www.qqjjsj.com/list226a1/
# 缓存 TTL（秒）：避免高频请求被封，默认 30 分钟
HYDRO_CACHE_TTL=1800

# ========== 上下文 token 压缩 ==========
# history 总 token 超过此值时触发 LLM 摘要压缩（借鉴 Codex compact）
HISTORY_MAX_TOKENS=4000
# 压缩时保留最近几轮原文（1 轮 = 1 问 1 答 = 2 条消息）
HISTORY_KEEP_RECENT_ROUNDS=2

# ========== MySQL 配置（自进化长期记忆 + 会话持久化存储）==========
# compose 已内置 mysql 服务，backend 通过服务名访问；密码与 mysql 服务的 MYSQL_ROOT_PASSWORD 对齐
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=water_agent
# 自进化总开关（false 时反思循环不运行，Agent 退化为无记忆模式）
SELF_EVOLUTION_ENABLED=true

# ========== Curator 定期记忆治理（借鉴 Hermes Curator）==========
# 后台线程定期执行：剪枝僵尸记忆 / LLM 压缩合并 / 向量索引对账
CURATOR_ENABLED=true
# 治理周期（小时），默认 168 = 每周一次
CURATOR_INTERVAL_HOURS=168
